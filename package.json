{
  "name": "typeorm-studio",
  "version": "1.2.0",
  "description": "Prisma-Studio-style data browser and editor for TypeORM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "seed": "tsx example/seed.ts",
    "studio:example": "node dist/cli.js -d example/data-source.ts",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p .",
    "build:ui": "esbuild ui-src/codemirror-entry.js --bundle --minify --format=iife --target=es2020 --outfile=ui/vendor/codemirror.js --legal-comments=none && node ui-src/licenses.js",
    "test:postgres": "TEST_DB=postgres node --test test/*.test.js",
    "test:mysql": "TEST_DB=mysql node --test test/*.test.js",
    "test:mariadb": "TEST_DB=mariadb node --test test/*.test.js",
    "test:mssql": "TEST_DB=mssql node --test test/*.test.js",
    "test:mongo": "TEST_DB=mongodb node --test test/mongo.test.js",
    "seed:mongo": "tsx example/mongo-seed.ts",
    "studio:mongo": "node dist/cli.js -d example/mongo-data-source.ts"
  },
  "keywords": [
    "typeorm",
    "studio",
    "database",
    "gui",
    "admin",
    "data-browser",
    "sql-editor",
    "postgres",
    "mysql",
    "mariadb",
    "sqlite",
    "mssql",
    "mongodb"
  ],
  "author": "BigBoyTips (https://github.com/BigBoyTips)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BigBoyTips/typeorm-studio.git"
  },
  "homepage": "https://github.com/BigBoyTips/typeorm-studio#readme",
  "bugs": {
    "url": "https://github.com/BigBoyTips/typeorm-studio/issues"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^12.11.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "mongodb": "^6.22.0",
    "mssql": "^11.0.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typeorm": "^0.3.0",
    "typescript": "5.6"
  },
  "bin": {
    "typeorm-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "typeorm": "^0.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
